# Copy lên server: /amb-storage-admin/.env.production (chủ sở hữu root, chmod 600).
# Dùng làm --env-file cho docker compose.

# Image đang chạy; CD tự cập nhật dòng này sau mỗi lần deploy (giữ đúng 1 dòng).
AMB_STORAGE_ADMIN_IMAGE=amb-storage-admin:initial

# Backend qua mạng nội bộ amb-network (container API của project amb-storage-prod, port 8000).
API_UPSTREAM=http://amb-storage-prod-api-1:8000
