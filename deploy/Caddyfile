# Phục vụ SPA + proxy /api về backend trên cùng domain.
# TLS do Caddy/reverse proxy phía trước lo; container này chỉ nghe HTTP nội bộ.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /healthz {
		respond 200
	}

	# Admin API + ảnh công khai. Giữ nguyên Host/Origin để AdminRequestSecurityGuard kiểm tra được.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:http://amb-storage-prod-api-1:8000}
	}

	# File có hash: cache vĩnh viễn. KHÔNG fallback về index.html — chunk cũ phải 404
	# để app bắt lỗi và tải lại, thay vì nhận HTML rồi trắng trang.
	handle /assets/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Mọi route của SPA trả index.html; index.html không cache để luôn trỏ tới bản build mới.
	handle {
		root * /srv
		header Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}
}
